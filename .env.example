# Optional local service URLs. When omitted, the Next.js adapters keep the demo functional.
JAVA_BACKEND_URL=http://127.0.0.1:8080
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Optional conversational understanding. Without this, verified built-in support remains available.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
